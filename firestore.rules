rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  // IMPORTANTE: integrar este bloque en las reglas existentes, NO reemplazar las reglas de otros ERP.
  function allowed() {return request.auth != null && exists(/databases/$(database)/documents/labpsi_costos_v1/accesos/usuarios/$(request.auth.uid));}
  function role() {return get(/databases/$(database)/documents/labpsi_costos_v1/accesos/usuarios/$(request.auth.uid)).data.role;}
  function editor() {return allowed() && role() in ['admin','gerencia','tecnico'];}
  match /labpsi_costos_v1/{category}/{collection}/{docId} {
   allow read: if allowed();
   allow create, update, delete: if editor() && category != 'accesos';
  }
  match /labpsi_costos_v1/accesos/usuarios/{uid} {
   allow read: if request.auth != null && (request.auth.uid == uid || (allowed() && role() == 'admin'));
   allow write: if false; // altas y roles mediante consola/admin SDK de confianza
  }
 }
}
